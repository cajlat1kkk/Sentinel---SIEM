/* Night overrides are appended to the shared component styles. */
* { color: #e9edf5; }
QMainWindow, #root { background: qlineargradient(x1:0,y1:0,x2:1,y2:1,stop:0 #0d111b,stop:0.6 #131824,stop:1 #161b2c); }
#surface { background: #151922; border-color: #303747; }
#brand, #title { color: #f0f3fa; }
#brandMark { color: #c2a6fa; }
#edition, #eyebrow { color: #a7b0c3; }
#navCapsule { background: #222837; }
QPushButton#topNav { color: #b3bdd0; }
QPushButton#topNav:hover { background: #30384b; color: #ffffff; }
QPushButton#topNav:checked { background: #4e406a; color: #f5efff; }
QPushButton#nav:hover { background: #2c3344; }
QPushButton#nav:checked { background: #584778; }
#subtitle, #muted { color: #b0bbcf; }
#tiny, #metricLabel, #workspaceStatus { color: #a7b2c8; }
#card { background: #1e2431; border-color: #303749; }
#cardTitle, #metricValue, #riskValue, #assetNumber { color: #ecf0f8; }
#focusCard { background: qlineargradient(x1:0,y1:0,x2:1,y2:1,stop:0 #675183,stop:0.45 #513a72,stop:1 #3c305c); }
#focusTitle, #focusNumber { color: #ffffff; }
#focusCaption { color: #e8ddf6; }
#focusDecoration { color: rgba(218,196,255,110); }
QPushButton#focusAction { background: #e8def7; color: #332442; }
QPushButton#focusAction:hover { background: #f5efff; }
#protectionRow[tone="0"] { background: #30273d; }
#protectionRow[tone="1"] { background: #253248; }
#protectionRow[tone="2"] { background: #253b34; }
#protectionRow[tone="3"] { background: #3c302a; }
#moduleName { color: #e2e7f1; }
#moduleState { color: #c1b7d0; }
QPushButton#moduleIcon:hover { background: #4a4057; }
#channelPill { color: #bac4d6; background: #293143; }
#networkStrip { background: #1b2130; border-color: #303749; }
#stripTitle, #stripValue { color: #d2daeb; }
#engineBadge { background: #2b3142; color: #bdc6dc; }
#chartLegend { color: #c1a9eb; }
#avatar { background: qlineargradient(x1:0,y1:0,x2:1,y2:1,stop:0 #847095,stop:1 #514259); border-color: #383344; color: #ffffff; }
#themeSwitcher { background: #272d3b; }
QPushButton#themeOption { color: #bac2d5; }
QPushButton#themeOption:checked { color: #f2eaff; background: #584675; }
#notice { background: #30283e; color: #ddc9f7; border-color: #574269; }
#notice[error="true"] { background: #422832; color: #ffc0ce; border-color: #70404f; }
#badge[tone="green"] { color: #8bdeb1; background: #224437; }
#badge[tone="warm"] { color: #f1be96; background: #49382d; }
#badge[tone="purple"] { color: #d0b8f5; background: #3d2e55; }
#badge[tone="gray"] { color: #bcc7dd; background: #30394c; }
QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox, QDateTimeEdit, QDateEdit, QTimeEdit { background: #191f2b; color: #e9edf5; border-color: #3a445a; selection-background-color: #6b528d; selection-color: #ffffff; }
QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus, QDateTimeEdit:focus { border-color: #c0a1f4; }
QLineEdit:disabled, QSpinBox:disabled, QComboBox:disabled { color: #8190a8; background: #1b202a; border-color: #30384a; }
#globalSearch, #periodSelector { background: #202635; color: #c9d2e3; border-color: #394257; }
QComboBox QAbstractItemView { background: #242c3b; color: #e3eaf8; border-color: #48536c; selection-background-color: #594777; selection-color: #ffffff; }
QComboBox::down-arrow { image: url(:/theme-chevron-down-night.svg); }
QSpinBox::up-arrow, QDoubleSpinBox::up-arrow { image: url(:/theme-chevron-up-night.svg); }
QSpinBox::down-arrow, QDoubleSpinBox::down-arrow { image: url(:/theme-chevron-down-night.svg); }
QSpinBox::up-button:hover, QSpinBox::down-button:hover, QDoubleSpinBox::up-button:hover, QDoubleSpinBox::down-button:hover { background: #3d3450; }
QPushButton { background: #2a3142; color: #e0e6f2; border-color: #3b455b; }
QPushButton:hover { background: #353c52; border-color: #8873a8; }
QPushButton:pressed { background: #443753; }
QPushButton:disabled { color: #7f8aa0; background: #222937; border-color: #30394b; }
QPushButton#primary { background: #bca0ed; color: #231a33; border-color: #bca0ed; }
QPushButton#primary:hover { background: #d1b7fa; }
QPushButton#primary:disabled { background: #514366; color: #a69ab8; border-color: #514366; }
QPushButton#danger { color: #ffb5c3; border-color: #6b3e4c; background: #392731; }
QPushButton#danger:hover { background: #4c2e3c; }
QPushButton#link { color: #c9b2ee; }
QPushButton#link:hover { color: #eadcff; }
QPushButton#quietAction { background: #2a3142; color: #cbd4e6; }
QPushButton#quietAction:hover { background: #443453; color: #ead8ff; }
QPushButton#roundButton, QPushButton#cardArrow { background: #293143; color: #c8b8df; }
QPushButton#roundButton:hover, QPushButton#cardArrow:hover { background: #443653; color: #f1e3ff; }
QPushButton#darkCircle { background: #63507f; color: #ffffff; }
QTableWidget, QTableView, QTreeView, QListView, QListWidget, QTreeWidget { background: #1e2431; alternate-background-color: #252d3d; color: #e0e8f5; border-color: #374157; gridline-color: #30384b; selection-background-color: #49385d; selection-color: #ffffff; }
QTableWidget::item { border-bottom-color: #30384b; }
QTableWidget::item:selected, QTableView::item:selected, QTreeView::item:selected, QListView::item:selected { background: #49385d; color: #ffffff; }
QHeaderView::section, QTableCornerButton::section { background: #252c3b; color: #bdc8de; border-color: #394357; }
QScrollBar::handle:vertical, QScrollBar::handle:horizontal { background: #48526a; }
QScrollBar::handle:vertical:hover, QScrollBar::handle:horizontal:hover { background: #75638f; }
QTextEdit, QPlainTextEdit { background: #171e2b; color: #e1e7f3; border-color: #3b455d; selection-background-color: #65507f; selection-color: #ffffff; }
QTabWidget::pane { background: #1e2431; border-color: #374157; }
QTabBar::tab { color: #acb8d0; }
QTabBar::tab:hover { background: #293143; color: #ffffff; }
QTabBar::tab:selected { color: #dcc7fc; border-bottom-color: #b598e8; }
QGroupBox { background: #202735; color: #d9e2f1; border: 1px solid #3b455b; border-radius: 14px; margin-top: 16px; padding: 15px; }
QGroupBox::title { subcontrol-origin: margin; subcontrol-position: top left; left: 13px; padding: 0 6px; color: #cfb8f0; }
QCheckBox, QRadioButton { color: #d9e1ef; }
QCheckBox:disabled, QRadioButton:disabled { color: #8290a7; }
QCheckBox::indicator, QRadioButton::indicator { background: #1c2431; border: 1px solid #68748d; }
QCheckBox::indicator:checked, QRadioButton::indicator:checked { background: #b59ae6; border-color: #d3bef2; }
QCheckBox::indicator:checked { image: url(:/theme-check-night.svg); }
QRadioButton::indicator:checked { border-color: #40495d; }
QCheckBox::indicator:hover, QRadioButton::indicator:hover { border-color: #d4b9fc; }
QProgressBar { background: #283144; color: #e9e1f7; border: 1px solid #45506a; border-radius: 6px; text-align: center; }
QProgressBar::chunk { background: #a88ad8; border-radius: 5px; }
QSlider::groove:horizontal { background: #35405a; height: 6px; border-radius: 3px; }
QSlider::handle:horizontal { background: #c0a4ec; width: 15px; margin: -5px 0; border-radius: 7px; }
QMenuBar, QMenu { background: #252d3c; color: #e3eaf6; border-color: #44516b; }
QMenu::item:selected, QMenuBar::item:selected { background: #514068; color: #ffffff; }
QMenu::separator { background: #424b61; height: 1px; margin: 5px 9px; }
QMenu::item:disabled { color: #8490a4; }
QDialog, QMessageBox, QFileDialog, QInputDialog { background: #1c2230; color: #e9edf5; }
QToolTip { background: #333d52; color: #ffffff; border: 1px solid #69718c; border-radius: 4px; padding: 8px; }
QPushButton:focus, QPushButton#primary:focus, QPushButton#danger:focus,
QPushButton#nav:focus, QPushButton#topNav:focus, QPushButton#themeOption:focus,
QPushButton#quietAction:focus, QPushButton#roundButton:focus, QPushButton#cardArrow:focus,
QPushButton#link:focus, QPushButton#focusAction:focus, QPushButton#darkCircle:focus,
QPushButton#moduleIcon:focus { border: 2px solid #d1b5ff; }
QCheckBox:focus, QRadioButton:focus { outline: 1px solid #c2a5f0; }
QTabBar::tab:focus { border-bottom-color: #ddc9ff; }
