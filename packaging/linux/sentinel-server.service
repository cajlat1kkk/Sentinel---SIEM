[Unit]
Description=Sentinel fleet management server
After=network-online.target postgresql.service
Wants=network-online.target
ConditionPathExists=/etc/sentinel-server/server.json

[Service]
Type=simple
User=sentinel-server
Group=sentinel-server
ExecStart=/usr/bin/siem-server --config /etc/sentinel-server/server.json
Restart=on-failure
RestartSec=5
TimeoutStopSec=35
StateDirectory=sentinel-server
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
